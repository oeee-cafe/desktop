<?xml version="1.0" encoding="utf-8"?>
<!--
  The MSIX package's manifest. package.ps1 fills in the $…$ values: the
  identity from Partner Center (Product management > Product identity) and
  the version from tauri.conf.json.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="$IDENTITY_NAME$"
    Publisher="$PUBLISHER$"
    Version="$VERSION$"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Oeee Cafe</DisplayName>
    <PublisherDisplayName>$PUBLISHER_DISPLAY_NAME$</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <!-- 1809 is the oldest Windows 10 that WebView2 runs on; it ships with
       Windows 11 and came to Windows 10 by Windows Update. -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <!-- The languages of words.rs; the first is the default. -->
  <Resources>
    <Resource Language="en-us" />
    <Resource Language="ko-kr" />
    <Resource Language="ja-jp" />
    <Resource Language="zh-cn" />
  </Resources>

  <Applications>
    <Application
      Id="OeeeCafe"
      Executable="oeee-cafe-desktop.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Oeee Cafe"
        Description="Draw oekaki with everyone on Oeee Cafe"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <!-- An ordinary desktop app, not a sandboxed one: every MSIX made from a
         Win32 program asks for this, and the Store expects it. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
