<?xml version="1.0" encoding="utf-8"?>
<!--
  The MSIX package's manifest. package.ps1 fills in the $…$ values: the
  identity from Partner Center (Product management > Product identity), the
  version from tauri.conf.json, and each package's architecture.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="$IDENTITY_NAME$"
    Publisher="$PUBLISHER$"
    Version="$VERSION$"
    ProcessorArchitecture="$ARCHITECTURE$" />

  <Properties>
    <DisplayName>Oeee Cafe</DisplayName>
    <PublisherDisplayName>$PUBLISHER_DISPLAY_NAME$</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <!-- 1809 is the oldest Windows 10 that WebView2 runs on; it ships with
       Windows 11 and came to Windows 10 by Windows Update. -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <!-- The languages the app speaks itself, on the loader before the site
       has come (loader/index.html; words.rs holds only English, for before
       the first page has sent its words), and the site's; the first is the
       default. -->
  <Resources>
    <Resource Language="en-us" />
    <Resource Language="ko-kr" />
    <Resource Language="ja-jp" />
    <Resource Language="zh-cn" />
  </Resources>

  <Applications>
    <Application
      Id="OeeeCafe"
      Executable="oeee-cafe-desktop.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Oeee Cafe"
        Description="Draw oekaki with everyone on Oeee Cafe"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />

      <!-- Coming back from a sign-in done in the browser. The site sends the
           browser to oeee-cafe://handoff/done once the provider has answered,
           and being opened is all it is for: it brings the window forward and
           the page asks the site at once (handoff.rs). It carries nothing.

           A packaged app takes its protocols from here, and only from here.
           The plugin registers this scheme in the registry at startup, which
           is what the Steam build needs, because Steam ships loose files and
           installs no package; inside MSIX that registry write is virtualised
           and does nothing, and this is what counts instead. -->
      <Extensions>
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="oeee-cafe">
            <uap:DisplayName>Oeee Cafe</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <!-- An ordinary desktop app, not a sandboxed one: every MSIX made from a
         Win32 program asks for this, and the Store expects it. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
